{
  "name": "@agentcore2/contracts",
  "version": "0.1.0",
  "description": "Shared domain contracts: compliance findings, evidence, remediation, backend adapter interface, and mock dataset. This is a DURABLE asset intended for harvest into cloudscape-remediation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/**/*.test.js\""
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5"
  },
  "license": "MIT"
}
